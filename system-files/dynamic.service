[Unit]
Description=Ultralytics ROS Startup Service Dynamic
After=network.target set-usb.service
Requires=set-usb.service

[Service]
Type=simple
User=astra
WorkingDirectory=/home/astra/dynamic_flight/
ExecStart=/bin/bash -c 'source /opt/ros/noetic/setup.bash && source catkin_ws/devel/setup.bash && python launcher.py'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target